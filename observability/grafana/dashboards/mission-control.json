{
  "title": "Mission Control",
  "uid": "mc-overview",
  "schemaVersion": 38,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "type": "row",
      "title": "System Health",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "id": 1,
      "collapsed": false
    },
    {
      "type": "stat",
      "title": "Uptime",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "id": 2,
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "mission_control_uptime_seconds{app='mission-control'}",
          "legendFormat": "uptime",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Preflight",
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "id": 3,
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "PASS",
                  "color": "green"
                },
                "0": {
                  "text": "FAIL",
                  "color": "red"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "mission_control_preflight_success{app='mission-control'}",
          "legendFormat": "preflight",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Heap Used",
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "id": 4,
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 200000000
              },
              {
                "color": "red",
                "value": 400000000
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "nodejs_heap_size_used_bytes{app='mission-control'}",
          "legendFormat": "heap used",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Event Loop Lag",
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "id": 5,
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.1
              },
              {
                "color": "red",
                "value": 0.5
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "nodejs_eventloop_lag_seconds{app='mission-control'}",
          "legendFormat": "event loop lag",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Open FDs",
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "id": 6,
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 200
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "process_open_fds{app='mission-control'}",
          "legendFormat": "open fds",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "CPU Usage",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 6
      },
      "id": 7,
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        }
      },
      "targets": [
        {
          "expr": "rate(process_cpu_seconds_total{app='mission-control'}[1m])",
          "legendFormat": "cpu",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Memory (RSS vs Heap)",
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 6
      },
      "id": 8,
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        }
      },
      "targets": [
        {
          "expr": "process_resident_memory_bytes{app='mission-control'}",
          "legendFormat": "rss",
          "refId": "A"
        },
        {
          "expr": "nodejs_heap_size_used_bytes{app='mission-control'}",
          "legendFormat": "heap used",
          "refId": "B"
        },
        {
          "expr": "nodejs_heap_size_total_bytes{app='mission-control'}",
          "legendFormat": "heap total",
          "refId": "C"
        }
      ]
    },
    {
      "type": "row",
      "title": "Tasks",
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 24,
        "h": 1
      },
      "id": 10,
      "collapsed": false
    },
    {
      "type": "stat",
      "title": "Tasks Created (total)",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 6,
        "h": 4
      },
      "id": 11,
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "mission_control_tasks_created_total{app='mission-control'}",
          "legendFormat": "created",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Tasks Created (rate/min)",
      "gridPos": {
        "x": 6,
        "y": 12,
        "w": 6,
        "h": 4
      },
      "id": 12,
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "rate(mission_control_tasks_created_total{app='mission-control'}[5m]) * 60",
          "legendFormat": "tasks/min",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Task Creations Over Time",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 6
      },
      "id": 13,
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        }
      },
      "targets": [
        {
          "expr": "increase(mission_control_tasks_created_total{app='mission-control'}[5m])",
          "legendFormat": "created (5m)",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Task Moves by Stage",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 6
      },
      "id": 14,
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        }
      },
      "targets": [
        {
          "expr": "increase(mission_control_tasks_moved_total{app='mission-control',to_status='DOING'}[5m])",
          "legendFormat": "\u2192 Doing",
          "refId": "A"
        },
        {
          "expr": "increase(mission_control_tasks_moved_total{app='mission-control',to_status='REVIEW'}[5m])",
          "legendFormat": "\u2192 Review",
          "refId": "B"
        },
        {
          "expr": "increase(mission_control_tasks_moved_total{app='mission-control',to_status='DONE'}[5m])",
          "legendFormat": "\u2192 Done",
          "refId": "C"
        },
        {
          "expr": "increase(mission_control_tasks_moved_total{app='mission-control',to_status='TODO'}[5m])",
          "legendFormat": "\u2192 Todo (revert)",
          "refId": "D"
        }
      ]
    },
    {
      "type": "row",
      "title": "Jobs & Idempotency",
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 1
      },
      "id": 20,
      "collapsed": false
    },
    {
      "type": "stat",
      "title": "Jobs Enqueued (total)",
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 6,
        "h": 4
      },
      "id": 21,
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "mission_control_jobs_enqueued_total{app='mission-control'}",
          "legendFormat": "enqueued",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Idempotency Hit Rate",
      "gridPos": {
        "x": 6,
        "y": 23,
        "w": 6,
        "h": 4
      },
      "id": 22,
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "rate(mission_control_idempotency_hits_total{app='mission-control'}[5m]) / (rate(mission_control_idempotency_hits_total{app='mission-control'}[5m]) + rate(mission_control_idempotency_misses_total{app='mission-control'}[5m]))",
          "legendFormat": "hit rate",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "DB Errors (total)",
      "gridPos": {
        "x": 12,
        "y": 23,
        "w": 6,
        "h": 4
      },
      "id": 23,
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(mission_control_db_errors_total{app='mission-control'}) or vector(0)",
          "legendFormat": "db errors",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "5xx Errors (total)",
      "gridPos": {
        "x": 18,
        "y": 23,
        "w": 6,
        "h": 4
      },
      "id": 24,
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(mission_control_http_5xx_total{app='mission-control'}) or vector(0)",
          "legendFormat": "5xx errors",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Idempotency Hits vs Misses",
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 12,
        "h": 6
      },
      "id": 25,
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        }
      },
      "targets": [
        {
          "expr": "rate(mission_control_idempotency_hits_total{app='mission-control'}[5m])",
          "legendFormat": "hits/s",
          "refId": "A"
        },
        {
          "expr": "rate(mission_control_idempotency_misses_total{app='mission-control'}[5m])",
          "legendFormat": "misses/s",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Jobs Enqueued Over Time",
      "gridPos": {
        "x": 12,
        "y": 27,
        "w": 12,
        "h": 6
      },
      "id": 26,
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        }
      },
      "targets": [
        {
          "expr": "increase(mission_control_jobs_enqueued_total{app='mission-control'}[5m])",
          "legendFormat": "{{job_type}}",
          "refId": "A"
        }
      ]
    }
  ]
}