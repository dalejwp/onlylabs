# ── Database ──────────────────────────────────────────────────────────────
DATABASE_URL="file:./mission-control.db"

# ── App ───────────────────────────────────────────────────────────────────
NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://mc.example.com

# ── Auth (required) ───────────────────────────────────────────────────────
MC_ADMIN_EMAIL=admin@example.com
MC_ADMIN_PASSWORD=change-me-strong-password
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MC_AUTH_SECRET=replace-with-64-char-hex-secret

# ── Notifications ─────────────────────────────────────────────────────────
MATON_API_KEY=           # NOT committed - use secrets manager in prod
MC_NOTIFY_EMAIL_TO=you@example.com
MC_NOTIFY_EMAIL_FROM=noreply@example.com
MC_NOTIFY_EMAIL_FROM_NAME=Mission Control

# ── Artifact storage (MinIO/S3 - falls back to local fs if unset) ─────────
S3_ENDPOINT=http://localhost:9000
S3_KEY=minioadmin
S3_SECRET=minioadmin
S3_BUCKET=mission-control
ARTIFACT_DIR=./data/artifacts

# ── External integrations (NOT committed - use secrets manager) ───────────
TELEGRAM_BOT_TOKEN=
APIFY_API_TOKEN=
OPENAI_API_KEY=
