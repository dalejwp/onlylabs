generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum TaskStatus {
  TODO
  DOING
  REVIEW
  DONE
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String?
  status      TaskStatus @default(TODO)
  priority    Int        @default(3)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  events      TaskEvent[]
}

model TaskEvent {
  id        String   @id @default(cuid())
  taskId    String
  type      String
  payload   String
  createdAt DateTime @default(now())

  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model DailyUsage {
  id           String @id @default(cuid())
  dateYYYYMMDD String @unique
  usedCount    Int    @default(0)
  limitCount   Int    @default(100)
}

// ── Idempotency ───────────────────────────────────────────────────────────────
model IdempotencyRecord {
  key       String   @id
  status    Int
  body      String
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
}

// ── Durable job queue ─────────────────────────────────────────────────────────
model Job {
  id             String    @id @default(cuid())
  jobType        String
  payload        String    // JSON
  status         String    @default("pending") // pending | running | done | failed | dead
  attempts       Int       @default(0)
  maxAttempts    Int       @default(3)
  lastError      String?
  idempotencyKey String?   @unique
  createdAt      DateTime  @default(now())
  runAt          DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, runAt])
}
